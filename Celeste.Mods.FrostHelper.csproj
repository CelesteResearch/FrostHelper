        <ProjectReference
            Include="$(SharedRoot)/src/Celeste.Game.Runtime/Celeste.Game.Runtime.csproj"
            Private="false"
        />
        <Reference Include="YamlDotNet" HintPath="$(SharedRoot)/lib/Everest/YamlDotNet.dll" Private="false" />
    </ItemGroup>
</Project>
